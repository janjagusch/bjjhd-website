---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaiSignup from '../components/CampaiSignup.astro';
import { Picture } from 'astro:assets';
import drillingImage from '../assets/beginners/drilling.jpg';
import instructionImage from '../assets/beginners/instruction.jpg';
import partnersImage from '../assets/beginners/partners.jpg';
import openMatImage from '../assets/beginners/open-mat.jpg';
import { beginnersCourse, campai, contact } from '../config';
import { withBase } from '../utils/withBase';

const c = beginnersCourse;

const gallery = [
  {
    image: instructionImage,
    alt: 'Zwei Trainingspartner üben eine Technik aus der Guard, im Hintergrund weitere Teilnehmer',
  },
  {
    image: partnersImage,
    alt: 'Zwei lachende Trainingspartner auf der Matte',
  },
  {
    image: openMatImage,
    alt: 'Mehrere Paare trainieren gleichzeitig auf der Matte im Athleticon',
  },
];

const facts = [
  {
    label: 'Umfang',
    text: `${c.classes} Trainingseinheiten für einen kompletten Einstieg in das Brazilian Jiu-Jitsu, von Grund auf.`,
  },
  {
    label: 'Termine',
    text: `Jeden ${c.weekday.de} um ${c.time} Uhr. Start am ${c.startDate.de}, letzte Einheit am ${c.endDate.de}. Kursteilnehmer:innen sind zusätzlich herzlich eingeladen, auch an unserem regulären Training am Freitag und Samstag mitzumachen.`,
  },
  {
    label: 'Ort',
    text: `${contact.venue}, ${c.room}, ${contact.venueStreet}, ${contact.venueZip} ${contact.venueCity}`,
    href: '/#location',
  },
  {
    label: 'Ausrüstung',
    text: 'Wir trainieren im Gi. Ein eigener Gi ist nicht Pflicht, aber empfohlen. Ansonsten reicht bequeme Sportkleidung.',
  },
  {
    label: 'Vorkenntnisse',
    text: 'Keine nötig. Der Kurs richtet sich ausdrücklich an absolute Einsteiger:innen.',
  },
  {
    label: 'Preis',
    text: `${c.price} für den gesamten Kurs, inklusive aller Trainingseinheiten.`,
  },
];
---

<BaseLayout
  title="Anfängerkurs Brazilian Jiu-Jitsu | BJJ Heidelberg"
  description={`Unser ${c.classes}-wöchiger Anfängerkurs für Brazilian Jiu-Jitsu in Heidelberg: jeden ${c.weekday.de} um ${c.time}, Start am ${c.startDate.de}. Keine Vorkenntnisse nötig.`}
  lang="de"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Anfängerkurs {c.startDate.de.split(' ').slice(-2).join(' ')}</p>
      <h1>In {c.classes} Einheiten zum Brazilian Jiu-Jitsu</h1>
      <p class="section__intro">
        Du wolltest schon immer mal Brazilian Jiu-Jitsu ausprobieren, aber nicht
        mitten in ein laufendes Training platzen? Dann ist unser Anfängerkurs
        genau richtig: {c.classes} aufeinander aufbauende Einheiten, in denen du
        gemeinsam mit anderen Einsteiger:innen die Grundlagen lernst: Positionen,
        Bewegung am Boden, erste Techniken und die wichtigsten Regeln für
        sicheres Training.
      </p>

      <figure class="lead">
        <Picture
          src={drillingImage}
          alt="Zwei Trainingspartner im Gi üben eine Position am Boden im Athleticon"
          widths={[640, 960, 1360, 2048]}
          sizes="(min-width: 1100px) 1040px, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
        />
      </figure>

      <ul class="facts">
        {
          facts.map((f) => (
            <li class="facts__item">
              <strong class="facts__label">{f.label}:</strong>{' '}
              {f.href ? <a href={withBase(f.href)}>{f.text}</a> : f.text}
            </li>
          ))
        }
      </ul>

      <p class="more">
        Mehr Hintergrundwissen findest du in unserem
        <a href={withBase('/einsteiger')}>Einsteiger-Guide</a> und in unseren
        <a href={withBase('/regeln')}>Regeln &amp; Richtlinien</a>.
      </p>

      <ul class="gallery">
        {
          gallery.map((item) => (
            <li class="gallery__item">
              <Picture
                src={item.image}
                alt={item.alt}
                widths={[480, 720, 1080]}
                sizes="(min-width: 900px) 33vw, 100vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <div class="booking" id="anmeldung">
        <h2>Anmeldung</h2>
        <p class="booking__intro">
          Melde dich direkt über das Formular unten an. Die Teilnehmerzahl ist
          begrenzt, wir empfehlen daher eine frühzeitige Anmeldung.
        </p>
        <CampaiSignup
          src={campai.beginnersCourseSrc}
          title="Anmeldung Anfängerkurs (bereitgestellt von Campai)"
        />
      </div>

      <div class="prose">
        <h2 id="teilnahmebedingungen">Teilnahmebedingungen</h2>
        <p class="placeholder">
          [Platzhalter: bitte vor Veröffentlichung prüfen und ergänzen.]
        </p>
        <ul>
          <li>
            [Mindestalter: 16 Jahre. Minderjährige benötigen die
            Einverständniserklärung einer/eines Erziehungsberechtigten.]
          </li>
          <li>
            [Die Teilnahme erfolgt auf eigene Gefahr. Bitte kläre vor Kursbeginn
            mit einem Arzt/einer Ärztin, ob du sportlich uneingeschränkt
            belastbar bist.]
          </li>
          <li>
            [Der Kursbeitrag von {c.price} ist vor der ersten Einheit fällig und
            gilt für den gesamten Kurs. Versäumte Einheiten können nicht
            nachgeholt oder erstattet werden.]
          </li>
          <li>
            Es gelten unsere
            <a href={withBase('/regeln')}>Regeln &amp; Richtlinien</a> sowie die
            <a
              href="https://www.tsg78-hd.de/images/verein/Benutzungsordnung_TSGSportpark_2025.pdf"
              target="_blank"
              rel="noopener noreferrer">Benutzungsordnung des TSG Sportparks ↗</a
            >.
          </li>
        </ul>

        <h2 id="datenschutz">Datenschutz &amp; Foto-/Videoaufnahmen</h2>
        <p class="placeholder">
          [Platzhalter: bitte vor Veröffentlichung prüfen und ergänzen.]
        </p>
        <ul>
          <li>
            [Deine Anmeldedaten werden ausschließlich zur Abwicklung des Kurses
            verarbeitet. Details siehe <a href={withBase('/datenschutz')}
              >Datenschutzerklärung</a
            >.]
          </li>
          <li>
            [Im Training entstehen gelegentlich Foto- und Videoaufnahmen, die wir
            für unsere Website und Social-Media-Kanäle nutzen möchten.]
          </li>
          <li>
            [Die Nutzung erfolgt nur mit deiner ausdrücklichen, freiwilligen
            Einwilligung. Du kannst diese jederzeit ohne Angabe von Gründen
            widerrufen. Schreib uns einfach an <a href={`mailto:${contact.email}`}
              >{contact.email}</a
            >.]
          </li>
          <li>
            [Eine Teilnahme am Kurs ist auch ohne Einwilligung in Aufnahmen
            möglich. Sag uns vor Ort kurz Bescheid, dann achten wir darauf.]
          </li>
        </ul>

        <h2>Noch Fragen?</h2>
        <p>
          Schreib uns einfach an
          <a href={`mailto:${contact.email}`}>{contact.email}</a>. Wir antworten so
          schnell wir können.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-300);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .facts {
    margin: var(--space-xl) 0 0;
    padding-left: 1.25rem;
    max-width: 70ch;
    display: grid;
    gap: var(--space-sm);
    font-size: var(--fs-500);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .facts__label {
    color: var(--color-heading);
  }

  .more {
    margin-top: var(--space-lg);
    max-width: 70ch;
    font-size: var(--fs-500);
    color: var(--color-text-muted);
  }

  .lead {
    margin: var(--space-xl) 0 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .lead :global(img) {
    display: block;
    width: 100%;
    height: clamp(240px, 38vw, 460px);
    object-fit: cover;
    object-position: center 40%;
  }

  .gallery {
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .prose {
    margin-top: var(--space-2xl);
    max-width: 70ch;
  }

  .prose h2 {
    font-size: var(--fs-600);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-md);
  }

  .prose h2:not(:first-child) {
    margin-top: var(--space-2xl);
  }

  .prose p,
  .prose ul {
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .prose ul {
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-xs);
  }

  .placeholder {
    font-style: italic;
  }

  .booking {
    margin-top: var(--space-2xl);
  }

  .booking h2 {
    font-size: var(--fs-600);
    margin-bottom: var(--space-sm);
  }

  .booking__intro {
    color: var(--color-text-muted);
    max-width: 70ch;
    margin-bottom: var(--space-lg);
  }
</style>
