---
import { trainingSchedule } from '../config';
import { ui, defaultLocale, homeAnchor } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = ui[lang];

// Localized weekday label from the canonical English `day` field.
const dayLabel = (day: string) =>
  t.weekdays[day.toLowerCase()] ?? day;
---

<div class="schedule">
  <table class="schedule__table">
    <caption class="visually-hidden">{t.schedule.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.schedule.day}</th>
        <th scope="col">{t.schedule.time}</th>
        <th scope="col">{t.schedule.class}</th>
        <th scope="col">{t.schedule.room}</th>
      </tr>
    </thead>
    <tbody>
      {
        trainingSchedule.map((slot) => (
          <tr>
            <th scope="row" data-label={t.schedule.day}>{dayLabel(slot.day)}</th>
            <td data-label={t.schedule.time}>{slot.time}</td>
            <td data-label={t.schedule.class}>
              {slot.title[lang]}
              {slot.level && (
                <span class="schedule__level">{slot.level[lang]}</span>
              )}
              {slot.note && (
                <span class="schedule__note">{slot.note[lang]}</span>
              )}
            </td>
            <td data-label={t.schedule.room}>
              {slot.roomUrl ? (
                <a href={slot.roomUrl} target="_blank" rel="noopener noreferrer">
                  {slot.room}{'\u00a0↗'}
                </a>
              ) : (
                <a href={homeAnchor(lang, 'location')} title={t.schedule.roomOnMap}>
                  {slot.room}
                </a>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .schedule {
    border: var(--rule) solid var(--dark);
    overflow: hidden;
    background-color: var(--light);
    color: var(--dark);
    --color-text-muted: #4d4944;
  }

  .schedule__table {
    width: 100%;
    border-collapse: collapse;
  }

  .schedule__table th,
  .schedule__table td {
    text-align: left;
    padding: var(--space-md) var(--space-lg);
  }

  .schedule__table thead th {
    background-color: var(--dark);
    color: var(--light);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-300);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .schedule__table tbody tr {
    border-top: var(--rule) solid var(--dark);
  }
  .schedule__table tbody tr:first-child {
    border-top: 0;
  }

  .schedule__table tbody th[scope='row'] {
    color: var(--dark);
    font-family: var(--font-heading);
    font-size: var(--fs-500);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .schedule__table tbody th[scope='row']::before {
    content: '';
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    background: var(--primary);
    border-radius: 50%;
  }
  .schedule__table tbody tr:nth-child(3n + 2) th[scope='row']::before {
    background: var(--accent);
    border-radius: 0;
  }
  .schedule__table tbody tr:nth-child(3n) th[scope='row']::before {
    background: var(--secondary);
    border-radius: 0;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .schedule__table td {
    font-variant-numeric: tabular-nums;
  }

  .schedule__table a {
    color: var(--dark);
    text-decoration-color: var(--primary);
  }

  .schedule__level,
  .schedule__note {
    display: inline-block;
    margin-left: var(--space-xs);
    padding: 0.15rem 0.6rem;
    background-color: var(--accent);
    color: var(--dark);
    font-size: var(--fs-300);
    font-weight: 600;
  }

  /* --- Card layout on small screens --- */
  @media (max-width: 640px) {
    .schedule__table thead {
      display: none;
    }
    .schedule__table,
    .schedule__table tbody,
    .schedule__table tr,
    .schedule__table th,
    .schedule__table td {
      display: block;
      width: 100%;
    }
    .schedule__table tr {
      padding: var(--space-sm) 0;
    }
    .schedule__table tbody th[scope='row'] {
      display: flex;
      padding-bottom: var(--space-xs);
    }
    .schedule__table td {
      display: flex;
      justify-content: space-between;
      gap: var(--space-md);
      padding-block: 0.35rem;
    }
    .schedule__table td::before {
      content: attr(data-label);
      color: var(--color-text-muted);
      font-size: var(--fs-300);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
  }
</style>
