---
import { club } from '../config';
import { withBase } from '../utils/withBase';
import { ui, getNav, routes, altLocale, defaultLocale, homeAnchor } from '../i18n';
import type { Locale, RouteKey } from '../i18n';

interface Props {
  lang?: Locale;
  /** Used to point the language switch at the same page in the other locale. */
  routeKey?: RouteKey;
}

const { lang = defaultLocale, routeKey } = Astro.props;
const t = ui[lang];
const nav = getNav(lang);
const other = altLocale(lang);
// Switch to the same page in the other language, else fall back to its home.
const switchHref = withBase(routeKey ? routes[routeKey][other] : routes.home[other]);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a
      href={withBase(routes.home[lang])}
      class="brand"
      aria-label={`${club.name} – ${t.homeAria}`}
    >
      <img
        src={withBase('/images/brand/mark.svg')}
        alt=""
        width="57"
        height="36"
        class="brand__mark"
      />
      <img
        src={withBase('/images/brand/wordmark-on-dark.svg')}
        alt={club.logoAlt}
        width="107"
        height="23"
        class="brand__wordmark"
      />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label={t.openMenu}
      data-close-label={t.closeMenu}
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label={t.mainNav}>
      <ul class="site-nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} class="site-nav__link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={withBase(homeAnchor(lang, 'trial'))}
            class="btn btn--primary site-nav__cta">{t.ctaTrial}</a
          >
        </li>
        <li>
          <a
            href={switchHref}
            class="site-nav__link site-nav__lang"
            lang={other}
            hreflang={other}
            aria-label={t.langSwitchAria}>{t.langSwitchLabel}</a
          >
        </li>
      </ul>
    </nav>
  </div>
  <div class="site-header__stripe" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</header>


<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--dark);
    color: var(--light);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
    gap: var(--space-md);
  }

  /* Tri-colour rule under the header: primary, secondary, accent. */
  .site-header__stripe {
    display: grid;
    grid-template-columns: 3fr 2fr 1fr;
    height: 6px;
  }
  .site-header__stripe span:nth-child(1) {
    background: var(--primary);
  }
  .site-header__stripe span:nth-child(2) {
    background: var(--secondary);
  }
  .site-header__stripe span:nth-child(3) {
    background: var(--accent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .brand__mark {
    width: 57px;
    height: auto;
  }
  .brand__wordmark {
    width: 107px;
    height: auto;
  }

  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    color: var(--light);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-400);
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .site-nav__link:hover {
    color: var(--light);
  }
  .site-nav__link:hover::after {
    transform: scaleX(1);
  }

  .site-nav__cta {
    padding: 0.5rem 1rem;
    border-color: var(--accent);
  }
  .site-nav__cta:hover {
    background-color: var(--light);
    border-color: var(--light);
    color: var(--dark);
  }

  .site-nav__lang {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-300);
    border: var(--rule) solid var(--light);
    padding: 0.3rem 0.55rem;
  }
  .site-nav__lang::after {
    display: none;
  }
  .site-nav__lang:hover {
    background: var(--light);
    color: var(--dark);
  }

  /* --- Mobile toggle button --- */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 46px;
    height: 46px;
    padding: 0;
    background: transparent;
    border: var(--rule) solid var(--light);
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    margin-inline: auto;
    background: var(--light);
    transition: transform var(--transition), opacity var(--transition);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- Mobile layout --- */
  @media (max-width: 1080px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      position: absolute;
      inset: calc(4.75rem + 6px) 0 auto 0;
      background-color: var(--dark);
      border-bottom: 6px solid var(--accent);
      display: none;
      max-height: calc(100vh - 5rem);
      overflow-y: auto;
    }
    .site-nav.is-open {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-sm) var(--container-pad) var(--space-lg);
    }
    .site-nav__list li {
      border-bottom: 1px solid rgba(var(--light-rgb), 0.18);
    }
    .site-nav__list li:last-child,
    .site-nav__list li:nth-last-child(2) {
      border-bottom: 0;
    }
    .site-nav__link {
      display: block;
      padding: var(--space-md) 0;
      font-size: var(--fs-500);
    }
    .site-nav__link::after {
      display: none;
    }
    .site-nav__cta {
      margin-top: var(--space-md);
      width: 100%;
    }
    .site-nav__lang {
      display: inline-block;
      margin-top: var(--space-md);
      padding: 0.4rem 0.7rem;
      font-size: var(--fs-300);
    }
  }

  @media (max-width: 380px) {
    .brand__wordmark {
      display: none;
    }
  }
</style>


<script>
  const toggle = document.querySelector('.nav-toggle');
  const navMenu = document.getElementById('primary-nav');

  if (toggle && navMenu) {
    // Localized labels are provided by the server-rendered aria-label.
    const openLabel = toggle.getAttribute('aria-label') ?? 'Open menu';
    const closeLabel = toggle.getAttribute('data-close-label') ?? openLabel;

    toggle.addEventListener('click', () => {
      const open = navMenu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
    });

    // Close the menu after choosing a link (mobile).
    navMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', openLabel);
      });
    });
  }
</script>
