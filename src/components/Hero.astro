---
/**
 * Landing-page hero.
 *
 * Bauhaus-style poster: headline and calls to action on the left, a grid
 * composition of photos (from `slideshow` in src/config.ts) and primary
 * shapes on the right. The photos are shown at once instead of crossfading.
 */
import { withBase } from '../utils/withBase';
import { ui, routes, homeAnchor, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';
import { slideshow } from '../config';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = ui[lang];
const [wide, strip, round] = slideshow;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title">
        Brazilian Jiu-Jitsu in <span class="hero__accent">Heidelberg</span>
      </h1>
      <div class="hero__actions">
        <a href={withBase(homeAnchor(lang, 'trial'))} class="btn btn--primary"
          >{t.ctaTrial}</a
        >
        <a href={withBase(routes.signup[lang])} class="btn btn--ghost"
          >{t.ctaMember}</a
        >
      </div>
    </div>

    <div class="hero__art">
      {
        wide && (
          <figure class="art art--wide photo-bw">
            <img
              src={withBase(wide.src)}
              alt={wide.alt[lang]}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        )
      }
      <div class="art art--round">
        {
          round && (
            <img
              class="photo-bw"
              src={withBase(round.src)}
              alt={round.alt[lang]}
              loading="eager"
              decoding="async"
            />
          )
        }
      </div>
      <div class="art art--secondary" aria-hidden="true"><span></span></div>
      <div class="art art--dot" aria-hidden="true"><span></span></div>
      {
        strip && (
          <figure class="art art--strip photo-bw">
            <img
              src={withBase(strip.src)}
              alt={strip.alt[lang]}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--dark);
    color: var(--light);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-xl);
      min-height: min(72vh, 700px);
    }
  }

  .hero__content h1 {
    color: var(--light);
    font-size: clamp(3rem, 8.2vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    display: inline-block;
    color: var(--accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .hero__actions .btn--primary {
    border-color: var(--accent);
  }
  .hero__actions .btn--primary:hover {
    background-color: var(--light);
    border-color: var(--light);
    color: var(--dark);
  }
  .hero__actions .btn--ghost {
    color: var(--light);
  }
  .hero__actions .btn--ghost:hover {
    background-color: var(--light);
    color: var(--dark);
  }

  /* --- Composition: 4 × 4 grid ------------------------------------------ */
  .hero__art {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 640px;
    justify-self: end;
    gap: 6px;
  }

  .art {
    position: relative;
    overflow: hidden;
    margin: 0;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art--wide {
    grid-column: 1 / 5;
    grid-row: 1 / 3;
  }
  .art--wide img {
    object-position: center 35%;
  }

  /* Photo in a circle on a primary-colour square. */
  .art--round {
    grid-column: 1 / 3;
    grid-row: 3 / 5;
    background-color: var(--primary);
    display: grid;
    place-items: center;
  }
  .art--round img {
    width: 88%;
    height: 88%;
    border-radius: 50%;
  }

  /* Secondary-colour square with a light half-disc. */
  .art--secondary {
    grid-column: 3 / 4;
    grid-row: 3 / 4;
    background-color: var(--secondary);
  }
  .art--secondary span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50%;
    background: var(--light);
    border-radius: 999px 999px 0 0;
  }

  /* Accent disc on a light square. */
  .art--dot {
    grid-column: 4 / 5;
    grid-row: 3 / 4;
    background-color: var(--light);
    display: grid;
    place-items: center;
  }
  .art--dot span {
    width: 64%;
    height: 64%;
    border-radius: 50%;
    background: var(--accent);
  }

  .art--strip {
    grid-column: 3 / 5;
    grid-row: 4 / 5;
  }
  .art--strip img {
    object-position: center 30%;
  }


  @media (max-width: 959px) {
    .hero {
      padding-block: var(--space-xl) var(--space-2xl);
    }
    .hero__art {
      justify-self: stretch;
      max-width: none;
    }
  }
</style>
