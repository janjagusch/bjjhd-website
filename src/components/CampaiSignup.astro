---
import { campai } from '../config';
import { withBase } from '../utils/withBase';
import { defaultLocale } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  /** Campai application form URL to embed. */
  src?: string;
  /** Short introductory line shown above the form. */
  intro?: string;
  /** Accessible title for the iframe. Defaults to a localized fallback. */
  title?: string;
  lang?: Locale;
}

const {
  src = campai.membershipFormSrc,
  intro,
  lang = defaultLocale,
  title = lang === 'de'
    ? 'Anmeldeformular (bereitgestellt von Campai)'
    : 'Application form (provided by Campai)',
} = Astro.props;

const de = lang === 'de';
// The privacy policy is German-only, so both locales link to the same page.
const privacyHref = withBase('/datenschutz');
---

<div class="campai">
  {intro && <p class="campai__intro">{intro}</p>}

  <div class="campai__frame">
    <iframe
      src={src}
      data-campai-id
      title={title}
      loading="lazy"
    ></iframe>
  </div>

  <p class="campai__hint">
    {
      de ? (
        <>
          Hinweis: Dieses Formular wird von Campai bereitgestellt. Mit dem
          Absenden werden deine Angaben zur Bearbeitung deiner Anfrage
          verarbeitet. Mehr dazu in unserer
          <a href={privacyHref}>Datenschutzerklärung</a>.
        </>
      ) : (
        <>
          Note: This form is provided by Campai. By submitting it, your details
          are processed to handle your request. Learn more in our
          <a href={privacyHref}>privacy policy</a>.
        </>
      )
    }
  </p>
</div>

<script is:inline src={campai.scriptSrc}></script>

<style>
  .campai {
    max-width: 760px;
    margin-inline: auto;
  }

  .campai__intro {
    font-size: var(--fs-500);
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .campai__frame {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-sm);
    overflow: hidden;
  }

  .campai__frame iframe {
    display: block;
    width: 100%;
    min-height: 720px;
    border: 0;
    border-radius: var(--radius-sm);
    background-color: #ffffff;
  }

  .campai__hint {
    margin-top: var(--space-md);
    font-size: var(--fs-300);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .campai__frame iframe {
      min-height: 860px;
    }
  }
</style>
