---
/**
 * Landing page content for the beginners course (Anfängerkurs).
 *
 * Course data (dates, price, venue) lives in `beginnersCourse` in
 * src/config.ts; the registration form URL in `campai.beginnersCourseSrc`.
 * Notes on photos/videos taken during training live in the privacy policy
 * (src/pages/datenschutz.astro).
 *
 * Typography on this page uses exactly three sizes: --fs-500 for the lead
 * paragraph, --fs-400 (body default) for every other line of copy, and
 * --fs-600 for section headings.
 */
import CampaiSignup from '../CampaiSignup.astro';
import { Picture } from 'astro:assets';
import drillingImage from '../../assets/beginners/drilling.jpg';
import instructionImage from '../../assets/beginners/instruction.jpg';
import partnersImage from '../../assets/beginners/partners.jpg';
import openMatImage from '../../assets/beginners/open-mat.jpg';
import { beginnersCourse, campai, contact } from '../../config';
import { withBase } from '../../utils/withBase';
import { routes, homeAnchor, defaultLocale } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const de = lang === 'de';
const c = beginnersCourse;

const benutzungsordnung =
  'https://www.tsg78-hd.de/images/verein/Benutzungsordnung_TSGSportpark_2025.pdf';

const conditionsId = de ? 'teilnahmebedingungen' : 'conditions';
const signupId = de ? 'anmeldung' : 'signup';

// Inline SVG paths (24x24, stroke-based) for the facts grid.
const icons = {
  scope:
    '<path d="M4 19V5a1 1 0 0 1 1-1h10l5 5v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z"/><path d="M8 12h8M8 16h5M14 4v5h5"/>',
  dates:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  location:
    '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="9" r="2.5"/>',
  gear:
    '<path d="M8 3 4 6v5l3-1v11h10V10l3 1V6l-4-3c-.5 1.7-2 3-4 3S8.5 4.7 8 3Z"/>',
  experience:
    '<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  price:
    '<path d="M20 12 12 20l-8-8V4h8l8 8Z"/><circle cx="8.5" cy="8.5" r="1.5"/>',
};

const gallery = [
  {
    image: instructionImage,
    alt: de
      ? 'Zwei Trainingspartner üben eine Technik aus der Guard, im Hintergrund weitere Teilnehmer'
      : 'Two training partners drilling a technique from the guard, with more participants in the background',
  },
  {
    image: partnersImage,
    alt: de
      ? 'Zwei lachende Trainingspartner auf der Matte'
      : 'Two laughing training partners on the mat',
  },
  {
    image: openMatImage,
    alt: de
      ? 'Mehrere Paare trainieren gleichzeitig auf der Matte im Athleticon'
      : 'Several pairs training at the same time on the mat in the Athleticon',
  },
];

const address = `${contact.venue}, ${c.room}, ${contact.venueStreet}, ${contact.venueZip} ${contact.venueCity}`;

const facts = de
  ? [
      {
        icon: icons.scope,
        label: 'Umfang',
        text: `${c.classes} Trainingseinheiten für einen kompletten Einstieg in das Brazilian Jiu-Jitsu, von Grund auf.`,
      },
      {
        icon: icons.dates,
        label: 'Termine',
        text: `Jeden ${c.weekday.de} um ${c.time} Uhr, vom ${c.startDate.de} bis zum ${c.endDate.de}. Zusätzlich bist du bei unserem regulären Training am Freitag und Samstag willkommen.`,
      },
      {
        icon: icons.location,
        label: 'Ort',
        text: address,
        href: homeAnchor(lang, 'location'),
      },
      {
        icon: icons.gear,
        label: 'Ausrüstung',
        text: 'Wir trainieren im Gi. Ein eigener Gi ist nicht Pflicht, aber empfohlen. Ansonsten reicht bequeme Sportkleidung.',
      },
      {
        icon: icons.experience,
        label: 'Vorkenntnisse',
        text: 'Keine nötig. Der Kurs richtet sich ausdrücklich an absolute Einsteiger:innen.',
      },
      {
        icon: icons.price,
        label: 'Preis',
        text: `Die erste Einheit ist kostenlos. Wenn du weitermachen möchtest, kostet der Kurs ${c.price}.`,
      },
    ]
  : [
      {
        icon: icons.scope,
        label: 'Scope',
        text: `${c.classes} sessions that take you into Brazilian Jiu-Jitsu from scratch.`,
      },
      {
        icon: icons.dates,
        label: 'Dates',
        text: `Every ${c.weekday.en} at ${c.time}, from ${c.startDate.en} to ${c.endDate.en}. You are also welcome at our regular training on Friday and Saturday.`,
      },
      {
        icon: icons.location,
        label: 'Location',
        text: address,
        href: homeAnchor(lang, 'location'),
      },
      {
        icon: icons.gear,
        label: 'Gear',
        text: 'We train in the Gi. Your own Gi is not required, but encouraged. Otherwise comfortable sportswear is fine.',
      },
      {
        icon: icons.experience,
        label: 'Experience',
        text: 'None needed. The course is aimed explicitly at complete beginners.',
      },
      {
        icon: icons.price,
        label: 'Price',
        text: `Your first session is free. If you decide to continue, the course costs ${c.price}.`,
      },
    ];
---

<section class="section">
  <div class="container">
    <p class="eyebrow">
      {de ? 'Anfängerkurs' : 'Beginners course'}
      {c.startDate[lang].split(' ').slice(-1)}
    </p>
    <h1>
      {
        de
          ? `In ${c.classes} Einheiten zum Brazilian Jiu-Jitsu`
          : `Start Brazilian Jiu-Jitsu in ${c.classes} sessions`
      }
    </h1>
    {
      de ? (
        <p class="section__intro">
          Du wolltest schon immer mal Brazilian Jiu-Jitsu ausprobieren, aber
          nicht mitten in ein laufendes Training platzen? Dann ist unser
          Anfängerkurs genau richtig: {c.classes} aufeinander aufbauende
          Einheiten, in denen du gemeinsam mit anderen Einsteiger:innen die
          Grundlagen lernst: Positionen, Bewegung am Boden, erste Techniken und
          die wichtigsten Regeln für sicheres Training.
        </p>
      ) : (
        <p class="section__intro">
          Always wanted to try Brazilian Jiu-Jitsu, but would rather not drop
          into an ongoing class? Then our beginners course is made for you:{' '}
          {c.classes} sessions that build on each other, in which you learn the
          basics together with other newcomers: positions, moving on the ground,
          your first techniques and the most important rules for safe training.
        </p>
      )
    }

    <p class="cta">
      <a href={`#${signupId}`} class="btn btn--primary"
        >{de ? 'Jetzt anmelden' : 'Register now'}</a
      >
      <span class="cta__note"
        >{
          de
            ? 'Erste Einheit kostenlos, keine Zahlung bei der Anmeldung.'
            : 'First session free, no payment when you sign up.'
        }</span
      >
    </p>

    <figure class="lead">
      <Picture
        src={drillingImage}
        alt={
          de
            ? 'Zwei Trainingspartner im Gi üben eine Position am Boden im Athleticon'
            : 'Two training partners in the Gi working a ground position in the Athleticon'
        }
        widths={[640, 960, 1360, 2048]}
        sizes="(min-width: 1100px) 1040px, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
      />
    </figure>

    <ul class="facts">
      {
        facts.map((f) => (
          <li class="facts__item">
            <span class="facts__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
                set:html={f.icon}
              />
            </span>
            <h2 class="facts__label">{f.label}</h2>
            <p class="facts__text">
              {f.href ? <a href={withBase(f.href)}>{f.text}</a> : f.text}
            </p>
          </li>
        ))
      }
    </ul>

    {
      de ? (
        <p class="more">
          Mehr Hintergrundwissen findest du in unserem
          <a href={withBase(routes.beginners[lang])}>Einsteiger-Guide</a> und in
          unseren <a href={withBase(routes.rules[lang])}
            >Regeln &amp; Richtlinien</a
          >.
        </p>
      ) : (
        <p class="more">
          You will find more background in our
          <a href={withBase(routes.beginners[lang])}>beginner’s guide</a> and in
          our <a href={withBase(routes.rules[lang])}>rules &amp; guidelines</a>.
        </p>
      )
    }

    <ul class="gallery">
      {
        gallery.map((item) => (
          <li>
            <Picture
              src={item.image}
              alt={item.alt}
              widths={[480, 720, 1080]}
              sizes="(min-width: 900px) 33vw, 100vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>

    <div class="booking" id={signupId}>
      <h2>{de ? 'Anmeldung' : 'Registration'}</h2>
      {
        de ? (
          <p>
            Melde dich einfach über das Formular unten an. Die erste Einheit
            ist kostenlos und unverbindlich, bezahlt wird erst, wenn du
            weitermachen möchtest. Die Teilnehmerzahl ist begrenzt, wir
            empfehlen daher eine frühzeitige Anmeldung. Es gelten unsere
            <a href={`#${conditionsId}`}>Teilnahmebedingungen</a>.
          </p>
        ) : (
          <p>
            Simply sign up via the form below. Your first session is free and
            without obligation, you only pay if you decide to continue. Places
            are limited, so we recommend registering early. Our
            <a href={`#${conditionsId}`}>conditions of participation</a> apply.
          </p>
        )
      }
      <CampaiSignup
        src={campai.beginnersCourseSrc}
        lang={lang}
        title={
          de
            ? 'Anmeldung Anfängerkurs (bereitgestellt von Campai)'
            : 'Beginners course registration (provided by Campai)'
        }
      />
    </div>

    <div class="prose">
      <h2 id={conditionsId}>
        {de ? 'Teilnahmebedingungen' : 'Conditions of participation'}
      </h2>
      {
        de ? (
          <ul>
            <li>
              Mindestalter: 16 Jahre. Minderjährige benötigen die
              Einverständniserklärung einer/eines Erziehungsberechtigten.
            </li>
            <li>
              Die Teilnahme erfolgt auf eigene Gefahr. Bitte kläre vor
              Kursbeginn mit einem Arzt/einer Ärztin, ob du sportlich
              uneingeschränkt belastbar bist.
            </li>
            <li>
              Die erste Einheit ist kostenlos und unverbindlich. Wenn du danach
              weitermachen möchtest, beträgt der Kursbeitrag {c.price} für den
              gesamten Kurs. Die Zahlungsdetails bekommst du von uns.
              Versäumte Einheiten können nicht nachgeholt oder erstattet
              werden.
            </li>
            <li>
              Es gelten unsere
              <a href={withBase(routes.rules[lang])}>Regeln &amp; Richtlinien</a>
              sowie die
              <a href={benutzungsordnung} target="_blank" rel="noopener noreferrer">
                Benutzungsordnung des TSG Sportparks&nbsp;↗
              </a>.
            </li>
          </ul>
        ) : (
          <ul>
            <li>
              Minimum age: 16. Minors need the written consent of a legal
              guardian.
            </li>
            <li>
              Participation is at your own risk. Please check with a doctor
              before the course starts whether you are fit to train without
              restrictions.
            </li>
            <li>
              Your first session is free and without obligation. If you decide
              to continue afterwards, the course fee is {c.price} for the
              entire course. We will send you the payment details. Missed
              sessions cannot be made up or refunded.
            </li>
            <li>
              Our <a href={withBase(routes.rules[lang])}>rules &amp; guidelines</a>
              apply, as do the
              <a href={benutzungsordnung} target="_blank" rel="noopener noreferrer">
                terms of use of the TSG Sportpark&nbsp;↗
              </a>.
            </li>
          </ul>
        )
      }

      <h2>{de ? 'Noch Fragen?' : 'Any questions?'}</h2>
      <p>
        {de ? 'Schreib uns einfach an ' : 'Just write to us at '}
        <a href={`mailto:${contact.email}`}>{contact.email}</a>{
          de
            ? '. Wir antworten so schnell wir können.'
            : '. We will reply as soon as we can.'
        }
      </p>
    </div>
  </div>
</section>

<style>
  /* Typography scale used on this page:
     --fs-300 eyebrow · --fs-400 body copy · --fs-500 lead · --fs-600 headings */
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-300);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .lead {
    margin: var(--space-xl) 0 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .lead :global(img) {
    display: block;
    width: 100%;
    height: clamp(240px, 38vw, 460px);
    object-fit: cover;
    object-position: center 40%;
  }

  .more,
  .booking p,
  .prose p,
  .prose ul {
    font-size: var(--fs-400);
    color: var(--color-text-muted);
    max-width: 70ch;
  }

  .cta {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  .cta__note {
    font-size: var(--fs-400);
    color: var(--color-text-muted);
  }

  .facts {
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .facts__item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .facts__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background-color: rgba(181, 86, 43, 0.1);
    color: var(--color-warm);
    margin-bottom: var(--space-md);
  }

  .facts__label {
    font-size: var(--fs-400);
    color: var(--color-heading);
    margin-bottom: var(--space-xs);
  }

  .facts__text {
    font-size: var(--fs-400);
    color: var(--color-text-muted);
  }

  .more {
    margin-top: var(--space-lg);
  }

  .gallery {
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .booking {
    margin-top: var(--space-2xl);
  }

  .booking h2,
  .prose h2 {
    font-size: var(--fs-600);
    margin-bottom: var(--space-sm);
  }

  .booking p {
    margin-bottom: var(--space-lg);
  }

  .prose {
    margin-top: var(--space-2xl);
    max-width: 70ch;
  }

  .prose h2 {
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-md);
  }

  .prose h2:not(:first-child) {
    margin-top: var(--space-2xl);
  }

  .prose p,
  .prose ul {
    margin-bottom: var(--space-md);
  }

  .prose ul {
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-xs);
  }
</style>
