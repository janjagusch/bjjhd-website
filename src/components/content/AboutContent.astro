---
import CoachCard from '../CoachCard.astro';
import { about, coaches, headCoach } from '../../config';
import { withBase } from '../../utils/withBase';
import { ui, defaultLocale } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = ui[lang];
---

<section class="section about-section">
  <div class="container container--wide">
    <div class="about">
      <h1>{t.aboutHeading}</h1>
      <div class="about__intro">
        {about.paragraphs.map((p) => <p>{p[lang]}</p>)}
      </div>
    </div>
    <img
      class="about__photo"
      src={withBase(about.photo)}
      alt={about.photoAlt[lang]}
      width="2000"
      height="1000"
      decoding="async"
    />
  </div>
</section>

<section class="section section--alt">
  <div class="container container--wide">
    <h2>{t.teamHeading}</h2>

    <article class="head-coach card">
      <img
        class="head-coach__photo"
        src={withBase(headCoach.photo)}
        alt={headCoach.photoAlt[lang]}
        width="320"
        height="320"
        loading="lazy"
        decoding="async"
      />
      <div class="head-coach__body">
        <h3 class="head-coach__name">{headCoach.name}</h3>
        <p class="head-coach__meta">
          <span>{headCoach.role[lang]}</span>
          <span class="head-coach__belt">{headCoach.belt[lang]}</span>
        </p>
        {
          headCoach.paragraphs.map((p) => (
            <p class="head-coach__text">{p[lang]}</p>
          ))
        }
      </div>
    </article>

    <div class="grid grid--3 co-trainers">
      {coaches.map((coach) => <CoachCard coach={coach} lang={lang} />)}
    </div>
  </div>
</section>

<style>
  .container--wide {
    max-width: 1360px;
  }

  .about__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-top: var(--space-2xl);
    background-color: var(--color-bg-elevated);
  }

  .about {
    display: grid;
    gap: var(--space-lg);
  }
  .about__intro {
    display: grid;
    gap: var(--space-md);
    font-size: var(--fs-500);
    color: var(--color-text-muted);
    max-width: 110ch;
  }
  .about__intro p:first-child {
    color: var(--color-text);
  }

  .head-coach {
    margin-top: var(--space-xl);
    padding: 0;
    overflow: hidden;
    display: grid;
    align-items: stretch;
  }
  @media (min-width: 760px) {
    .head-coach {
      grid-template-columns: 440px 1fr;
    }
  }
  .head-coach__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    align-self: start;
    background-color: var(--color-bg-elevated);
  }

  @media (min-width: 760px) {
    .head-coach__photo {
      width: calc(100% - 2 * var(--space-lg));
      margin: var(--space-lg) 0 var(--space-lg) var(--space-lg);
      border-radius: var(--radius-md);
    }
  }
  .head-coach__body {
    padding: var(--space-lg);
  }
  @media (min-width: 760px) {
    .head-coach__body {
      padding: var(--space-xl);
    }
  }
  .head-coach__name {
    font-size: var(--fs-700);
  }
  .head-coach__meta {
    display: flex;
    flex-direction: column;
    margin: 0.15rem 0 var(--space-md);
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .head-coach__belt {
    color: var(--color-warm);
  }
  .head-coach__text {
    color: var(--color-text-muted);
    max-width: 75ch;
  }
  .head-coach__text:last-child:not(:first-of-type) {
    font-style: italic;
  }
  .head-coach__text + .head-coach__text {
    margin-top: var(--space-md);
  }

  .co-trainers {
    margin-top: var(--space-lg);
  }
</style>
