---
import { club, contact, social } from '../config';
import { withBase } from '../utils/withBase';
import { ui, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__stripe" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img
        class="site-footer__logo"
        src={withBase('/images/brand/logo-on-dark.svg')}
        alt=""
        width="551"
        height="496"
        loading="lazy"
      />
      <span class="brand__name">{club.name}</span>
      {
        social.instagram && (
          <a
            class="site-footer__social"
            href={social.instagram}
            target="_blank"
            rel="noopener noreferrer me"
          >
            <svg
              class="site-footer__social-icon"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
            </svg>
            <span>
              <span class="site-footer__social-label">{t.footerFollow}:</span>{' '}
              {social.instagramHandle ?? 'Instagram'}
            </span>
          </a>
        )
      }
    </div>

    <nav class="site-footer__col" aria-label={t.footerContact}>
      <h2 class="site-footer__heading">{t.footerContact}</h2>
      <address>
        {contact.legalEntity}<br />
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </address>
    </nav>

    <nav class="site-footer__col" aria-label={t.footerLegal}>
      <h2 class="site-footer__heading">{t.footerLegal}</h2>
      <ul class="site-footer__links">
        <li><a href={withBase('/impressum')}>{t.footerImpressum}</a></li>
        <li><a href={withBase('/datenschutz')}>{t.footerDatenschutz}</a></li>
        <li><a href={withBase('/documents')}>{t.footerDocuments}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {contact.legalEntity}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--charcoal);
    padding-block: 0 var(--space-lg);
    color: rgba(245, 241, 232, 0.78);
  }

  .site-footer__stripe {
    display: grid;
    grid-template-columns: 1fr 2fr 3fr;
    height: 6px;
    margin-bottom: var(--space-2xl);
  }
  .site-footer__stripe span:nth-child(1) {
    background: var(--vermilion);
  }
  .site-footer__stripe span:nth-child(2) {
    background: var(--cobalt);
  }
  .site-footer__stripe span:nth-child(3) {
    background: var(--mustard);
  }

  .site-footer a {
    color: var(--bone);
    text-decoration-color: var(--mustard);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .site-footer__logo {
    width: 140px;
    height: auto;
    margin-bottom: var(--space-lg);
  }

  .brand__name {
    color: var(--bone);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-600);
    letter-spacing: -0.01em;
  }

  .site-footer__heading {
    color: var(--bone);
    font-size: var(--fs-300);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .site-footer__heading::before {
    content: '';
    width: 1.25rem;
    height: 3px;
    background: var(--vermilion);
  }

  address {
    font-style: normal;
    line-height: var(--lh-base);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-footer__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    text-decoration: none;
  }

  .site-footer__social:hover,
  .site-footer__social:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--mustard);
  }

  .site-footer__social-icon {
    flex: none;
  }

  .site-footer__social-label {
    color: rgba(245, 241, 232, 0.78);
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .site-footer__bottom {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(245, 241, 232, 0.18);
    font-size: var(--fs-300);
  }
</style>
